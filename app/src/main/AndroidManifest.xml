<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- OpenGL ES 3.0 for 3D rendering (no ARCore required) -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <application
        android:name=".VirtualBodyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/whitecat"
        android:label="@string/app_name"
        android:roundIcon="@drawable/whitecat"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyVirtualBody">
        <activity
            android:name=".SplashHostActivity"
            android:exported="true"
            android:theme="@style/Theme.MyVirtualBody">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyVirtualBody" />
    </application>

</manifest>